# Production build (npm run build). No secrets here: everything below ends up in the public JS bundle.
# The API is on the same domain behind Caddy, so a relative base URL works for every domain.
VITE_API_BASE_URL=/api
VITE_APP_NAME=ModMove
# Never set VITE_DEMO_MODE in production: it shows demo accounts and a fake PayOS "paid" button.
