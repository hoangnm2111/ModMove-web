# Serves the built app. BrowserRouter: every unknown path gets index.html, so a reload on /orders works.
:80 {
	root * /srv
	encode zstd gzip

	# Vite puts a content hash in asset names: cache them for a year. Pages (index.html) are always revalidated.
	@assets path /assets/*
	@pages not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @pages Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
