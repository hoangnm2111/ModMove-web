w=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s109" target="s110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe120" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s111" target="s112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe121" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s112" target="s113"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe122" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s113" target="s114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="fe123" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s114" target="s115"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="wrap124" value="HTTP 200 · PagedResult&amp;lt;T&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=blockThin;endFill=1;endSize=6;strokeColor=#C47F00;strokeWidth=1.4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontSize=9;fontColor=#C47F00;" edge="1" parent="1" source="s110" target="s111"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1271" y="1320"/><mxPoint x="175" y="1320"/></Array></mxGeometry></mxCell><mxCell id="note125" value="&lt;b&gt;Why this pattern&lt;/b&gt;: the cache is the single source of truth, so two screens showing the same entity never disagree, and a driver tab and a customer tab stay in sync through the 'storage' event. Step 9 reads from the cache only — it never triggers another request, which is what keeps the subscribe loop from recursing." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFFF;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="50" y="1444" width="1340" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>